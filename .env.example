# Bring your own key (BYOK). This app ships with NO API key and NO
# default paid model. Every user plugs in their own provider, key and
# model. With nothing set, everything still works: embeddings run on a
# local model and answers are extractive (composed from the documents).
#
# Copy what you need to .env or set it in your shell. The same values
# can also be saved from the app with POST /settings/llm, which writes
# config/llm_settings.json on your own machine (gitignored).

# --- LLM (answering) ---
# Provider: extractive | openai-compatible | gemini | anthropic | ollama
LLM_PROVIDER=extractive
# Your own key for the provider above. Never commit a real key.
LLM_API_KEY=
# Any model name your provider offers, for example gpt-4o-mini,
# llama-3.3-70b-versatile, gemini-2.0-flash, claude-3-5-sonnet-latest,
# or a local Ollama model such as llama3.1.
LLM_MODEL=
# Base URL. Only needed to point openai-compatible at something other
# than OpenAI itself (Groq: https://api.groq.com/openai/v1, Together,
# OpenRouter, a local LM Studio server, ...), or to set a local
# Ollama address (default http://localhost:11434).
LLM_BASE_URL=

# --- Embeddings (search) ---
# auto tries the local sentence-transformers model first and falls
# back to a plain TF-IDF index if the model cannot be downloaded.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
